<?xml version="1.0" encoding="utf-8"?>
<!-- Sin copia en la nube ni transferencia de dispositivo en el MVP: el progreso
     persistente se recupera desde la cuenta vinculada, no desde backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
